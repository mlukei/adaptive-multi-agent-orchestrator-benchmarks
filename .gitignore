__pycache__
*.pyc
.DS_Store
.init
*.log
.env
.vscode/*

# Generated run artifacts
logs/
outputs*/
cache/
results/
output/_backups/*

# Ignore experiment configs while keeping the documented template.
configs/**
!configs/template.yaml

# Ignore generated task assets, but keep evaluation configs and testbed inputs versionable.
tasks/**
!tasks/officebench/
!tasks/officebench/*/
!tasks/officebench/*/subtasks/
!tasks/officebench/*/subtasks/*.json
!tasks/officebench/*/testbed/
!tasks/officebench/*/testbed/**
!tasks/officebench/*/reference/
!tasks/officebench/*/reference/**
!tasks/gaia/
!tasks/gaia/*/
!tasks/gaia/*/subtasks/
!tasks/gaia/*/subtasks/*.json

# analysis
analysis/*
!analysis/*.py
!analysis/metrics/
!analysis/metrics/*.py
!analysis/*.ipynb

# uv
.venv/
.uv_cache/
