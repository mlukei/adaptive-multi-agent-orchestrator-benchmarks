# Required
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_KEY="your-azure-api-key-here"
AZURE_OPENAI_API_VERSION="2024-12-01-preview"

# Fallback chat deployment. Only used when a config leaves llm.model_name unset.
# The configs normally name the deployment per role (orchestrator, agents,
# curator, judge), and those take precedence.
AZURE_OPENAI_DEPLOYMENT="your-default-azure-deployment-name"

# Optional
# Vision deployment for the GAIA analyze_image_with_llm tool (default: gpt-4o).
#GAIA_VISION_MODEL="gpt-4o"

# Retries for Azure API calls (default: 8).
#AZURE_OPENAI_MAX_RETRIES="8"

# Set to true to force an OfficeBench Docker image rebuild on the next run.
#OFFICEBENCH_REBUILD_DOCKER="false"

# Hugging Face token for scripts/provision_gaia_testbeds.py (GAIA attachments).
#HF_TOKEN="hf_..."
